[Unit]
Description=go2rtc streaming server (bbwatch camera stack)
Documentation=https://github.com/AlexxIT/go2rtc
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/go2rtc -config /etc/go2rtc.yaml
Restart=always
RestartSec=5
# Camera (libcamera) and ALSA mic access
User=kanai
SupplementaryGroups=video audio

[Install]
WantedBy=multi-user.target
