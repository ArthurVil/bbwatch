# Copy this file to docker/.env and fill in your values.
# docker/.env is gitignored — never commit credentials.

# --- Network access restriction ---
# Bind go2rtc ports to your Pi's LAN IP to block external access.
# Find it with: ip -4 addr show | grep 192.168
# Leave as 0.0.0.0 to listen on all interfaces (less secure).
BBWATCH_BIND_IP=0.0.0.0

# --- go2rtc authentication ---
# Protects the web UI (http://pi:1984) and all streams with HTTP Basic Auth.
GO2RTC_USERNAME=admin
GO2RTC_PASSWORD=changeme

# --- Audio source (set by Makefile, override here if needed) ---
# HOST_AUDIO_SOURCE=alsa_input.usb-...
