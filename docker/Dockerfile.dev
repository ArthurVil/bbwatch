# docker/Dockerfile.dev
FROM python:3.11-slim-bookworm

LABEL maintainer="bbwatch contributors"
LABEL description="Development environment for bbwatch baby monitor"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    alsa-utils \
    v4l-utils \
    libsndfile1 \
    libportaudio2 \
    pulseaudio \
    pulseaudio-utils \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgtk2.0-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy project files for dependency installation
COPY pyproject.toml ./
COPY README.md ./
COPY bbwatch/__init__.py ./bbwatch/

# Install all dependencies including dev + demo extras
# Note: demo extra includes opencv-python which needs the system libs above
RUN python3 -m pip install --no-cache-dir -e ".[dev]"

# Copy source
COPY . .

# Reinstall in editable mode with full source
RUN python3 -m pip install --no-cache-dir -e ".[dev]"

# Default command: run tests
CMD ["python3", "-m", "pytest", "-v", "--tb=short"]
